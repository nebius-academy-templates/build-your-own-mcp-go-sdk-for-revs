# Made-up tokens for trying the Log Triage server on your own machine.
# Every value here is an example: never use these tokens for anything real.
#
# Load them into your shell from the repository root before you start the
# server with --http, and again in the terminal where you start a host:
#
#   set -a; . 4-agents-and-clients/tokens.example.env; set +a

# What the server accepts: token=principal or token=principal:read-only.
# Two tokens name the same principal, analyst, so a scan made with one works with the other.
LOG_TRIAGE_TOKENS=example-analyst-token-1=analyst,example-analyst-token-2=analyst,example-viewer-token=viewer:read-only

# What a host sends. hosts.md reads this one.
LOG_TRIAGE_TOKEN=example-analyst-token-1

# The read-only caller, for trying the surface without save_finding.
LOG_TRIAGE_VIEWER_TOKEN=example-viewer-token
